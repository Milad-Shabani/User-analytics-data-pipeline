# Copy this file to .env and adjust as needed.

# Which warehouse backend to use: sqlite | mssql | postgres
DB_BACKEND=sqlite

# Used when DB_BACKEND=sqlite (default, zero setup)
SQLITE_PATH=./data/processed/warehouse.db

# Used when DB_BACKEND=mssql
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=AnalyticsDW
MSSQL_USER=sa
MSSQL_PASSWORD=change_me
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# Used when DB_BACKEND=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
